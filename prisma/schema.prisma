generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id         BigInt     @id @default(autoincrement())
  first_name      String     @db.VarChar(255)
  last_name       String     @db.VarChar(255)
  email           String     @unique @db.VarChar(255)
  whatsapp_number String     @unique @db.VarChar(50)
  website         String?    @db.VarChar(255)
  country         String?    @db.VarChar(100)
  gst_num         String     @unique @db.VarChar(50)

  password        String     @db.VarChar(255)   // 🔐 hashed password
  business_name   String?    @db.VarChar(255)   // optional business name
  role            String     @default("client") @db.VarChar(50)

  api_key         String?
  status          Int?       @default(1) @db.SmallInt
  isPremium       Boolean    @default(false)
  created_by      String?    @default("self") @db.VarChar(20)

  campaigns       Campaign[]
  contacts        Contact[]
  messages        Message[]
  templates       Template[]

  @@map("User")
}


model Campaign {
  campaignid BigInt   @id @default(autoincrement())
  userid     BigInt
  createdON  DateTime @default(now()) @db.Timestamptz
  status     Boolean  @default(true)

  user       User     @relation(fields: [userid], references: [user_id], onDelete: Cascade)

  messages   Message[]

  @@map("campaign")
}

model Campaign {
  campaignid BigInt   @id @default(autoincrement())
  userid     BigInt
  createdON  DateTime @default(now()) @db.Timestamptz
  status     Boolean  @default(true)

  user       User     @relation(fields: [userid], references: [user_id], onDelete: Cascade)

  messages   Message[]

  @@map("campaign")
}


model Contact {
  contactId BigInt   @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  phoneNum  String?  @db.VarChar(20)
  userId    BigInt?

  user      User?    @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  receipts  MessageReceipt[]

  @@map("contacts")
}

model Message {
  messageid  BigInt   @id @default(autoincrement())
  message    String   @db.Text
  image      String?  @db.VarChar(255)
  campaignid BigInt?
  user_id    BigInt
  button     String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamptz

  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  campaign   Campaign? @relation(fields: [campaignid], references: [campaignid])

  receipts   MessageReceipt[]

  @@map("messages")
}

model MessageReceipt {
  sentid          BigInt   @id @default(autoincrement())
  messageid       BigInt
  contactid       BigInt
  template_id     Int?
  provider_msg_id String?  @db.VarChar(100)
  status          String   @default("queued") @db.VarChar(50)
  sent_at         DateTime @default(now()) @db.Timestamptz
  delivered_at    DateTime? @db.Timestamptz
  read_at         DateTime? @db.Timestamptz
  error_message   String?  @db.Text

  message   Message  @relation(fields: [messageid], references: [messageid], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactid], references: [contactId], onDelete: Cascade)
  template  Template? @relation(fields: [template_id], references: [template_id], onDelete: SetNull)

  @@index([messageid])
  @@index([contactid])
  @@index([status])
  @@index([provider_msg_id])
  @@index([template_id])

  @@map("message_receipts")
}

model Template {
  template_id      Int      @id @default(autoincrement())
  created_by       BigInt

  template_name    String   @unique @db.VarChar(100)
  category         String   @db.VarChar(30)
  language         String   @db.VarChar(10)
  template_type    String   @default("custom") @db.VarChar(30)

  header_type      String?  @db.VarChar(20)
  header_text      String?  @db.VarChar(255)
  header_media_url String?  @db.Text

  message_body     String   @db.Text
  footer_text      String?  @db.VarChar(255)

  variable_count   Int      @default(0)
  variables        Json?

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user        User            @relation(fields: [created_by], references: [user_id], onDelete: Cascade)
  buttons     TemplateButton[]
  receipts    MessageReceipt[]

  @@map("template_table")
}

model TemplateButton {
  button_id    Int      @id @default(autoincrement())
  template_id  Int
  button_type  String   @db.VarChar(30)
  button_text  String   @db.VarChar(25)
  button_value String?  @db.VarChar(255)
  position     Int
  created_at   DateTime @default(now())

  template     Template @relation(fields: [template_id], references: [template_id], onDelete: Cascade)

  @@map("template_buttons")
}



